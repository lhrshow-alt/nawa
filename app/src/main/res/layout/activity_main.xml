<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF"
        android:clickable="false"
        android:focusable="false" />

    <ImageButton
        android:id="@+id/flashButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="76dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="Flash"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flash_off" />

    <ImageButton
        android:id="@+id/switchButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="Switch camera"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_switch_camera" />

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="130dp"
        android:background="@drawable/bg_info_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/mapThumb"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="#37474F"
            android:contentDescription="Map"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Waiting for GPS…"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/captureButton"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_capture_button"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/thumbView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="46dp"
        android:background="@drawable/bg_thumb"
        android:clipToOutline="true"
        android:contentDescription="Last photo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/shareButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="46dp"
        android:background="@drawable/bg_share_button"
        android:contentDescription="Share on WhatsApp"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_share"
        android:visibility="gone" />
</FrameLayout>
